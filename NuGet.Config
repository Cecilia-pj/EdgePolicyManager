<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.cdn.azure.cn 在本机已不可用（连接直接失败 / 代理 502），
    会让 dotnet restore 每次卡满超时。这里 <disabledPackageSources> 只清掉
    <clear /> 列出的那些源，未列出的源（含上面 add 的华为云）保持原样生效。
  -->
  <disabledPackageSources>
    <clear />
    <add key="azure" value="true" />
  </disabledPackageSources>
</configuration>